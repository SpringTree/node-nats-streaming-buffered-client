{
  "name": "node-nats-streaming-buffered-client",
  "version": "1.6.0",
  "description": "A NATS Streaming client with a publish ring buffer and reconnect logic for intermittent connections",
  "keywords": [
    "buffer",
    "nats",
    "nats-streaming",
    "stan"
  ],
  "homepage": "https://github.com/SpringTree/node-nats-streaming-buffered-client#readme",
  "bugs": {
    "url": "https://github.com/SpringTree/node-nats-streaming-buffered-client/issues"
  },
  "license": "MIT",
  "author": "Mark Doeswijk <mark@springtree.nl>",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/SpringTree/node-nats-streaming-buffered-client.git"
  },
  "files": [
    "dist"
  ],
  "type": "module",
  "module": "./dist/node-nats-streaming-buffered-client.js",
  "types": "./dist/node-nats-streaming-buffered-client.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/node-nats-streaming-buffered-client.d.ts",
        "default": "./dist/node-nats-streaming-buffered-client.js"
      }
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "bunup",
    "dev": "bunup --watch",
    "fmt": "oxfmt --check",
    "fmt:fix": "oxfmt",
    "lint": "oxlint",
    "lint:fix": "oxlint --fix",
    "prepare": "husky",
    "test": "bun test",
    "test:watch": "bun test --watch",
    "type-check": "tsc --noEmit"
  },
  "devDependencies": {
    "@commitlint/cli": "^21.2.4",
    "@commitlint/config-conventional": "^21.2.4",
    "@types/bun": "^1.4.4",
    "bunup": "^0.16.32",
    "husky": "^9.1.7",
    "lint-staged": "^17.6.1",
    "node-nats-streaming": "^0.3.2",
    "oxfmt": "^0.79.0",
    "oxlint": "^1.94.0",
    "oxlint-tsgolint": "^7.0.2007",
    "typescript": "^7.0.2"
  },
  "peerDependencies": {
    "node-nats-streaming": "^0.2.2 || ^0.3.0"
  },
  "engines": {
    "node": ">=22"
  }
}
